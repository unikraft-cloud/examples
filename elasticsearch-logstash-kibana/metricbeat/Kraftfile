spec: v0.6

name: metricbeat

runtime: base-compat:latest

labels:
  cloud.unikraft.v1.instances/scale_to_zero.policy: "off"
  cloud.unikraft.v1.instances/scale_to_zero.stateful: "true"
  cloud.unikraft.v1.instances/scale_to_zero.cooldown_time_ms: 1000

rootfs: ./Dockerfile

cmd: [ "/usr/share/metricbeat/metricbeat --environment container -c /usr/share/metricbeat/metricbeat.yml" ]
