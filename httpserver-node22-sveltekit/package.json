		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/eslint": "^8.56.0",
		"@typescript-eslint/eslint-plugin": "^8.73.0",
		"@typescript-eslint/parser": "^8.73.0",
		"eslint": "^8.56.0",
		"eslint-plugin-svelte": "^2.35.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.0.0",
		"tslib": "^2.4.1",
		"typescript": "^6.0.0",
		"vite": "^8.0.16"
	},
	"type": "module"
}
