spec: v0.6

name: minecraft

runtime: base-compat:latest

labels:
  cloud.unikraft.v1.instances/scale_to_zero.policy: "off" # could be "idle" if you want to pause the server when empty
  cloud.unikraft.v1.instances/scale_to_zero.stateful: "true"
  cloud.unikraft.v1.instances/scale_to_zero.cooldown_time_ms: 1000

rootfs: image/rootfs.erofs

cmd: [ "/wrapper.sh", "/start" ]
